# Keep the tree readable across editors and platforms.
# Line endings are pinned in .gitattributes: *.sh must be LF or bash fails on the
# shebang, *.ps1 must be CRLF.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.ps1]
end_of_line = crlf
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 100

[*.md]
# Two trailing spaces are a hard line break in markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
